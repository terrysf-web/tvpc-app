rules_version = '2';

// 설교 녹음 파일 보관 규칙.
//
// Storage 규칙은 Firestore를 읽을 수 없어(admins 컬렉션 확인 불가), 대신
// "이메일로 로그인한 계정"만 올릴 수 있게 한다 — 교인은 익명 로그인이라
// 이메일이 없고, 사역자만 이메일·비밀번호로 로그인하기 때문이다.
// 실제 어느 사역자가 올렸는지는 파일 경로가 아니라 verses 문서 쓰기
// 권한(Firestore 규칙 isAdmin)이 막아 준다.
service firebase.storage {
  match /b/{bucket}/o {
    match /sermonAudio/{file} {
      // 교인 누구나 들을 수 있어야 하므로 읽기는 열어 둔다.
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.token.email != null
        && request.resource.size < 80 * 1024 * 1024
        && request.resource.contentType.matches('audio/.*|video/mp4');
      allow delete: if request.auth != null && request.auth.token.email != null;
    }
    // 유튜브에 올릴 영상의 첫 화면(표지) — 녹음을 올릴 때 앱이 함께 만들어
    // 올리고, 서버가 그 그림에 소리를 입혀 영상으로 만든다.
    match /sermonCover/{file} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.token.email != null
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null && request.auth.token.email != null;
    }

    // 서버가 만들어 두는 유튜브용 영상 — 목회자가 받아서 유튜브에 올린다.
    // 만드는 것은 서버(관리자 권한)라 여기서는 읽기만 열어 둔다.
    match /sermonVideo/{file} {
      allow read: if true;
      allow write, delete: if false;
    }

    // 그 밖의 경로는 모두 막는다.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}

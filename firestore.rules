rules_version = '2';

// 무료(Spark) 요금제 기준 Firestore 보안 규칙.
// - 콘텐츠(말씀/설교/소식/일정): 누구나 읽기, 관리자(admins 컬렉션 등록 이메일)만 쓰기
// - 기도요청: 누구나 읽기, 익명 인증 사용자 작성 + 좋아요, 관리자 삭제(운영)
// - 관리자 등록: Firebase 콘솔에서 admins 컬렉션에 문서 ID = 이메일 로 추가
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.token.email));
    }

    match /admins/{email} {
      // 본인 여부 확인용 읽기만 허용, 쓰기는 콘솔에서만
      allow read: if request.auth != null && request.auth.token.email == email;
      allow write: if false;
    }

    match /verses/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /sermons/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /news/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /events/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /pushTokens/{token} {
      // 알림 토큰 등록·해제 — 익명 로그인 사용자. 목록 읽기는 서버(발송 스크립트)만
      allow read: if false;
      allow create, delete: if request.auth != null;
      allow update: if false;
    }

    match /prayers/{id} {
      allow read: if true;

      // 작성: 익명 로그인 사용자, 필드 형식 검증 + 본문 1000자 제한
      allow create: if request.auth != null
        && request.resource.data.keys().hasAll(['category', 'answered', 'text', 'authorName', 'createdAt', 'prayCount'])
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 1000
        && request.resource.data.authorName is string
        && request.resource.data.authorName.size() <= 40
        && request.resource.data.prayCount == 0;

      // 수정: "함께 기도" 카운트(±1)만 허용 (관리자는 전체 수정 가능)
      allow update: if isAdmin()
        || (request.auth != null
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['prayCount'])
            && (request.resource.data.prayCount - resource.data.prayCount == 1
                || request.resource.data.prayCount - resource.data.prayCount == -1)
            && request.resource.data.prayCount >= 0);

      // 삭제: 관리자만 (부적절한 글 운영)
      allow delete: if isAdmin();
    }
  }
}

rules_version = '2';

// 무료(Spark) 요금제 기준 Firestore 보안 규칙.
// - 콘텐츠(말씀/설교/소식/일정): 누구나 읽기, 관리자(admins 컬렉션 등록 이메일)만 쓰기
// - 기도요청: 누구나 읽기, 익명 인증 사용자 작성 + 좋아요, 관리자 삭제(운영)
// - 관리자 등록: Firebase 콘솔에서 admins 컬렉션에 문서 ID = 이메일 로 추가
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.token.email));
    }

    // 승인된 교인 — 주소록·헌금 내역·기도요청 이용 가능
    function isApprovedMember() {
      return request.auth != null
        && exists(/databases/$(database)/documents/members/$(request.auth.uid))
        && get(/databases/$(database)/documents/members/$(request.auth.uid)).data.status == 'approved';
    }

    match /admins/{email} {
      // 본인 여부 확인용 읽기만 허용, 쓰기는 콘솔에서만
      allow read: if request.auth != null && request.auth.token.email == email;
      allow write: if false;
    }

    match /verses/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /verseBg/{slot} {
      // 말씀카드 시간대별 배경 — 누구나 읽기, 등록은 관리자만
      allow read: if true;
      allow write: if isAdmin();
    }

    match /sermons/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /news/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /events/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 자동 동기화 상태 — 관리자 화면 표시용, 기록은 서버(서비스 계정)만
    match /syncStatus/{id} {
      allow read: if true;
      allow write: if false;
    }

    // 긴급 알림 큐 — 관리자가 등록(pending)하면 Cloud Functions가 즉시 발송하고
    // 상태를 기록한다. 발송 결과 확인을 위해 읽기는 관리자만.
    match /alerts/{id} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 60
        && request.resource.data.body is string
        && request.resource.data.body.size() > 0
        && request.resource.data.body.size() <= 500
        && request.resource.data.status == 'pending';
      allow update, delete: if false;
    }

    // 소식 카드 배너 — 누구나 보고, 등록은 관리자만
    match /newsBanner/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /bulletins/{date} {
      // 이미지 주보 — 인쇄물 QR 코드로 누구나 열람, 등록은 관리자만
      allow read: if true;
      allow write: if isAdmin();

      match /pages/{page} {
        allow read: if true;
        allow write: if isAdmin();
      }
    }

    match /albums/{id} {
      // 교회 앨범(사진 주소록) — 주보 QR과 같은 공개 자료
      allow read: if true;
      allow write: if isAdmin();

      // 하위 컬렉션 전체(pages·rows 등) 동일 규칙
      match /{section}/{docId} {
        allow read: if true;
        allow write: if isAdmin();
      }
    }

    match /members/{uid} {
      // 읽기: 본인·관리자·승인 교인(주소록 열람)
      allow read: if isAdmin()
        || (request.auth != null && request.auth.uid == uid)
        || isApprovedMember();
      // 가입 신청: 본인 문서를 pending 상태로만 생성
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.status == 'pending'
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 40;
      // 수정: 관리자(승인 포함) 또는 본인(연락처 정보만, 승인 상태 변경 불가)
      allow update: if isAdmin()
        || (request.auth != null && request.auth.uid == uid
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['name', 'phone', 'address', 'city', 'state', 'zip']));
      allow delete: if isAdmin();
    }

    match /offeringRecords/{id} {
      // 본인 헌금 내역만 열람, 등록·수정은 관리자(재정 담당)만
      allow read: if isAdmin()
        || (request.auth != null && resource.data.uid == request.auth.uid);
      allow write: if isAdmin();
    }

    match /pushTokens/{token} {
      // 알림 토큰 등록·해제 — 익명 로그인 사용자.
      // 같은 기기가 다시 켜면 기존 문서 덮어쓰기(update)가 되므로 함께 허용.
      // 목록 읽기는 발송 서버와 관리자(알림 기기 현황 표시)만.
      allow read: if isAdmin();
      allow create, update, delete: if request.auth != null;
    }

    match /prayers/{id} {
      // 기도요청 — 앱 사용자는 익명 인증으로 자동 로그인되므로
      // 별도 교인 로그인 없이 이용 (로그인은 관리자만 사용하는 정책)
      allow read: if request.auth != null;

      // 작성: 익명 인증 사용자, 필드 형식 검증 + 본문 1000자 제한
      allow create: if request.auth != null
        && request.resource.data.keys().hasAll(['category', 'answered', 'text', 'authorName', 'createdAt', 'prayCount'])
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 1000
        && request.resource.data.authorName is string
        && request.resource.data.authorName.size() <= 40
        && request.resource.data.prayCount == 0;

      // 수정: "함께 기도" 카운트(±1)만 허용 (관리자는 전체 수정 가능)
      allow update: if isAdmin()
        || (request.auth != null
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['prayCount'])
            && (request.resource.data.prayCount - resource.data.prayCount == 1
                || request.resource.data.prayCount - resource.data.prayCount == -1)
            && request.resource.data.prayCount >= 0);

      // 삭제: 관리자만 (부적절한 글 운영)
      allow delete: if isAdmin();
    }
  }
}
